wire pll2_2_CLKOUT4;
wire pll2_2_CLKOUT5;
wire pll2_2_CLKOUT6;
wire pll2_2_CLKFBOUT;
wire VCC;
wire GND;
  PLL pll1 (
    .LOCK(lock1),
    .CLKOUT0(mid_clk),
    .CLKOUT1(pll1_2_CLKOUT1),
    .CLKOUT2(pll1_2_CLKOUT2),
    .CLKOUT3(pll1_2_CLKOUT3),
    .CLKOUT4(pll1_2_CLKOUT4),
    .CLKOUT5(pll1_2_CLKOUT5),
    .CLKOUT6(pll1_2_CLKOUT6),
    .CLKFBOUT(pll1_2_CLKFBOUT),
    .CLKIN(clk_d),
    .CLKFB(GND),
    .RESET(pll1_reset),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .FBDSEL({GND,GND,GND,GND,GND,GND}),
    .IDSEL({GND,GND,GND,GND,GND,GND}),
    .MDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .MDSEL_FRAC({GND,GND,GND}),
    .ODSEL0({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL0_FRAC({GND,GND,GND}),
    .ODSEL1({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL2({GND,GND,GND,GND,GND,GND,GND}),
