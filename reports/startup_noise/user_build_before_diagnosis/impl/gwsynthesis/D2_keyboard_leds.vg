module pll_pair (
  clk_d,
  pll1_reset,
  pll2_reset,
  lock1,
  lock2,
  audio_clk
)
;
input clk_d;
input pll1_reset;
input pll2_reset;
output lock1;
output lock2;
output audio_clk;
wire mid_clk;
wire pll1_2_CLKOUT1;
wire pll1_2_CLKOUT2;
wire pll1_2_CLKOUT3;
wire pll1_2_CLKOUT4;
wire pll1_2_CLKOUT5;
