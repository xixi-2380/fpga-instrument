module keyboard_top (
  clk,
  rst,
  key_row,
  key_col,
  HP_BCK,
  HP_WS,
  HP_DIN,
  PA_EN,
  DBG_BCK,
  DBG_WS,
  DBG_DIN,
  DBG_PA_EN,
  led_n
)
;
input clk;
input rst;
input [3:0] key_row;
inout [3:0] key_col;
output HP_BCK;
output HP_WS;
output HP_DIN;
output PA_EN;
output DBG_BCK;
output DBG_WS;
output DBG_DIN;
output DBG_PA_EN;
output [5:0] led_n;
wire clk_d;
wire rst_d;
wire key_col_0_6;
wire key_col_1_6;
wire key_col_2_6;
wire key_col_3_10;
wire n4_6;
wire led_n_d_4_4;
wire led_n_d_5_4;
wire lock1;
wire lock2;
wire audio_clk;
wire pll2_reset;
wire pll1_reset;
wire audio_reset;
wire DBG_BCK_d;
wire gate_Z;
wire DBG_PA_EN_d;
wire DBG_DIN_d;
wire DBG_WS_d;
wire [3:0] key_row_d;
wire [3:0] led_n_d;
wire [1:0] column;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_ibuf (
    .O(rst_d),
    .I(rst) 
);
  IBUF key_row_0_ibuf (
    .O(key_row_d[0]),
    .I(key_row[0]) 
);
  IBUF key_row_1_ibuf (
    .O(key_row_d[1]),
    .I(key_row[1]) 
);
  IBUF key_row_2_ibuf (
    .O(key_row_d[2]),
    .I(key_row[2]) 
);
  IBUF key_row_3_ibuf (
    .O(key_row_d[3]),
    .I(key_row[3]) 
);
  TBUF key_col_3_s1 (
    .O(key_col[0]),
    .I(GND),
    .OEN(key_col_0_6) 
);
  TBUF key_col_3_s2 (
    .O(key_col[1]),
    .I(GND),
    .OEN(key_col_1_6) 
);
  TBUF key_col_3_s3 (
    .O(key_col[2]),
    .I(GND),
    .OEN(key_col_2_6) 
);
  TBUF key_col_3_s4 (
    .O(key_col[3]),
    .I(GND),
    .OEN(key_col_3_10) 
);
  OBUF HP_BCK_obuf (
    .O(HP_BCK),
    .I(DBG_BCK_d) 
);
  OBUF HP_WS_obuf (
    .O(HP_WS),
    .I(DBG_WS_d) 
);
  OBUF HP_DIN_obuf (
    .O(HP_DIN),
    .I(DBG_DIN_d) 
);
  OBUF PA_EN_obuf (
    .O(PA_EN),
    .I(DBG_PA_EN_d) 
);
  OBUF DBG_BCK_obuf (
    .O(DBG_BCK),
    .I(DBG_BCK_d) 
);
  OBUF DBG_WS_obuf (
    .O(DBG_WS),
    .I(DBG_WS_d) 
);
  OBUF DBG_DIN_obuf (
    .O(DBG_DIN),
    .I(DBG_DIN_d) 
);
  OBUF DBG_PA_EN_obuf (
    .O(DBG_PA_EN),
    .I(DBG_PA_EN_d) 
);
  OBUF led_n_0_obuf (
    .O(led_n[0]),
    .I(led_n_d[0]) 
);
  OBUF led_n_1_obuf (
    .O(led_n[1]),
    .I(led_n_d[1]) 
);
  OBUF led_n_2_obuf (
    .O(led_n[2]),
    .I(led_n_d[2]) 
);
  OBUF led_n_3_obuf (
    .O(led_n[3]),
    .I(led_n_d[3]) 
);
  OBUF led_n_4_obuf (
    .O(led_n[4]),
    .I(led_n_d_4_4) 
);
  OBUF led_n_5_obuf (
    .O(led_n[5]),
    .I(led_n_d_5_4) 
);
  LUT3 key_col_0_s2 (
    .F(key_col_0_6),
    .I0(audio_reset),
    .I1(column[0]),
    .I2(column[1]) 
);
defparam key_col_0_s2.INIT=8'hFE;
  LUT3 key_col_1_s2 (
    .F(key_col_1_6),
    .I0(audio_reset),
    .I1(column[1]),
    .I2(column[0]) 
);
defparam key_col_1_s2.INIT=8'hEF;
  LUT3 key_col_2_s2 (
    .F(key_col_2_6),
    .I0(audio_reset),
    .I1(column[0]),
    .I2(column[1]) 
);
defparam key_col_2_s2.INIT=8'hEF;
  LUT3 key_col_3_s7 (
    .F(key_col_3_10),
    .I0(audio_reset),
    .I1(column[0]),
    .I2(column[1]) 
);
defparam key_col_3_s7.INIT=8'hBF;
  INV n4_s2 (
    .O(n4_6),
    .I(audio_reset) 
);
  run_leds status_leds (
    .n4_6(n4_6),
    .clk_d(clk_d),
    .gate_Z(gate_Z),
    .led_n_d_4_4(led_n_d_4_4),
    .led_n_d_5_4(led_n_d_5_4),
    .led_n_d(led_n_d[3:0])
);
  pll_pair clocks (
    .clk_d(clk_d),
    .pll1_reset(pll1_reset),
    .pll2_reset(pll2_reset),
    .lock1(lock1),
    .lock2(lock2),
    .audio_clk(audio_clk)
);
  clock_reset reset_control (
    .clk_d(clk_d),
    .rst_d(rst_d),
    .lock1(lock1),
    .lock2(lock2),
    .audio_clk(audio_clk),
    .pll2_reset(pll2_reset),
    .pll1_reset(pll1_reset),
    .audio_reset(audio_reset)
);
  keyboard_core core (
    .audio_clk(audio_clk),
    .audio_reset(audio_reset),
    .key_row_d(key_row_d[3:0]),
    .DBG_BCK_d(DBG_BCK_d),
    .gate_Z(gate_Z),
    .DBG_PA_EN_d(DBG_PA_EN_d),
    .DBG_DIN_d(DBG_DIN_d),
    .DBG_WS_d(DBG_WS_d),
    .column(column[1:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* keyboard_top */
