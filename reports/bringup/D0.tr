  TC_CLOCK             Actived   create_clock -name ref_clk -period 20.000 [get_ports {clk}]                                                                                                   
  TC_GENERATED_CLOCK   Actived   create_generated_clock -name mid_clk -source [get_ports {clk}] -multiply_by 16 -divide_by 25 [get_pins {engine/clocks/pll1/CLKOUT0}]                          
  TC_GENERATED_CLOCK   Actived   create_generated_clock -name audio_clk -source [get_pins {engine/clocks/pll1/CLKOUT0}] -multiply_by 48 -divide_by 25 [get_pins {engine/clocks/pll2/CLKOUT0}]  
  TC_MAX_DELAY         Actived   set_max_delay -from [get_clocks {audio_clk}] -to [get_ports {HP_BCK HP_WS HP_DIN PA_EN}] 30.000                                                               
  TC_MIN_DELAY         Actived   set_min_delay -from [get_clocks {audio_clk}] -to [get_ports {HP_BCK HP_WS HP_DIN PA_EN}] 0.000                                                                

