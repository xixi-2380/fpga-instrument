wire pll2_2_CLKOUT5;
wire pll2_2_CLKOUT6;
wire pll2_2_CLKFBOUT;
wire VCC;
wire GND;
  PLL pll1 (
    .LOCK(lock1),
    .CLKOUT0(mid_clk),
    .CLKOUT1(pll1_2_CLKOUT1),
    .CLKOUT2(pll1_2_CLKOUT2),
    .CLKOUT3(pll1_2_CLKOUT3),
    .CLKOUT4(pll1_2_CLKOUT4),
    .CLKOUT5(pll1_2_CLKOUT5),
    .CLKOUT6(pll1_2_CLKOUT6),
    .CLKFBOUT(pll1_2_CLKFBOUT),
    .CLKIN(clk_d),
    .CLKFB(GND),
    .RESET(pll1_reset),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .FBDSEL({GND,GND,GND,GND,GND,GND}),
    .IDSEL({GND,GND,GND,GND,GND,GND}),
    .MDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .MDSEL_FRAC({GND,GND,GND}),
    .ODSEL0({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL0_FRAC({GND,GND,GND}),
    .ODSEL1({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL2({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL3({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL4({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL5({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL6({GND,GND,GND,GND,GND,GND,GND}),
    .DT0({GND,GND,GND,GND}),
    .DT1({GND,GND,GND,GND}),
    .DT2({GND,GND,GND,GND}),
    .DT3({GND,GND,GND,GND}),
    .ICPSEL({GND,GND,GND,GND,GND,GND}),
    .LPFRES({GND,GND,GND}),
    .LPFCAP({GND,GND}),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
    .PSPULSE(GND),
    .ENCLK0(VCC),
    .ENCLK1(GND),
    .ENCLK2(GND),
    .ENCLK3(GND),
    .ENCLK4(GND),
    .ENCLK5(GND),
    .ENCLK6(GND),
    .SSCPOL(GND),
    .SSCON(GND),
    .SSCMDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .SSCMDSEL_FRAC({GND,GND,GND}) 
);
defparam pll1.CLKFB_SEL="INTERNAL";
defparam pll1.FBDIV_SEL=1;
defparam pll1.FCLKIN="50";
defparam pll1.IDIV_SEL=1;
defparam pll1.MDIV_SEL=16;
defparam pll1.ODIV0_SEL=25;
  PLL pll2 (
    .LOCK(lock2),
    .CLKOUT0(audio_clk),
    .CLKOUT1(pll2_2_CLKOUT1),
    .CLKOUT2(pll2_2_CLKOUT2),
    .CLKOUT3(pll2_2_CLKOUT3),
    .CLKOUT4(pll2_2_CLKOUT4),
